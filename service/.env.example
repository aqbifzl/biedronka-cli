# How often to refresh every saved account's access token, in seconds.
# refresh_token rotates and resets its own ~120 day expiry each time it's
# used, so refreshing well inside that window keeps sessions alive forever.
REFRESH_INTERVAL_SECONDS=43200

# How often to poll for a pending shakeomat slot / activation readiness,
# in seconds. The two daily slots can open close together, so keep this low.
CHECK_INTERVAL_SECONDS=15

# SMTP settings for sending the notification email.
# Port 465 = implicit TLS (SMTP_SSL). Port 587 = STARTTLS.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=kotek@icloud.com

# accounts.json lives on the ./data volume (see docker-compose.yml) -
# copy it there from your own machine's ~/.config/biedronka-cli/accounts.json.
# New accounts can't be added from inside the container (login needs a real
# browser for the Cloudflare Turnstile step).
